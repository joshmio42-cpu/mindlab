{
  "name": "mindlab-workbench-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run src",
    "e2e": "playwright test",
    "contracts": "openapi-typescript ../docs/openapi.json -o src/schema.ts",
    "lint": "eslint src",
    "format": "prettier --write src tests *.ts *.js",
    "format:check": "prettier --check src tests *.ts *.js"
  },
  "dependencies": {
    "lucide-react": "1.50.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
